---
import NavBar from "@components/NavBar.astro";
import Footer from "@components/Footer.astro";
import "../styles/global.css";
import "@fontsource/lxgw-wenkai-mono-tc";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Carlos Fontán - Desarrollador Software | IoT & Automatización",
  description = "Desarrollador de software especializado en IoT, automatización industrial y tecnologías web fullstack. Node-RED, Docker, OPC-UA, MQTT.",
} = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <SpeedInsights />
    <title>{title}</title>
  </head>
  <body>
    <main
      class="container min-h-screen flex flex-col mx-auto max-w-7xl p-4 sm:p-6 md:p-8 lg:p-10 shadow-none sm:shadow-[4px_0_12px_-4px_rgba(0,0,0,0.08),-4px_0_12px_-4px_rgba(0,0,0,0.08)]"
    >
      <NavBar />
      <slot />
      <Footer />
    </main>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    background-color: #ffffff;
    font-family: "LXGW WenKai Mono TC", monospace;
  }
</style>
