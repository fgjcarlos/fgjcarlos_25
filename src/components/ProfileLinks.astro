---
import { Icon } from "astro-icon/components";
import LinksData from "../config/links.json";

const links = LinksData.links;
---

<div class="flex gap-4 justify-center md:justify-start mt-4 group">
  {
    links.map((link, index) => (
      <a
        href={link.src}
        target={link.blank ? "_blank" : "_self"}
        class="transform transition-all duration-300 hover:scale-110 hover:-translate-y-1 hover:text-primary text-base-content/60 hover:shadow-md interactive-smooth"
        aria-label={link.title}
        style={`transition-delay: ${index * 100}ms`}
      >
        <Icon name={link.icon} class="size-6" />
      </a>
    ))
  }
</div>
