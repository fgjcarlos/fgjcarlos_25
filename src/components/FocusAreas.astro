---
import { focusAreas } from "@config/focusAreas";
---

<section
  id="areas"
  class="w-full grid gap-4 md:grid-cols-3 mt-10 animate-fade-in"
  aria-label="Áreas de trabajo"
>
  {
    focusAreas.map((area) => (
      <article class="surface-card rounded-box border border-base-300 bg-base-200 shadow-sm p-4 transition-all duration-300 hover:-translate-y-1 hover:shadow-md">
        <h2 class="text-base font-semibold mb-2">{area.title}</h2>
        <p class="text-sm leading-relaxed text-base-content/70">
          {area.description}
        </p>
      </article>
    ))
  }
</section>
