---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const projects = await getCollection("projects");
const visible = projects
  .filter((p) => !p.data.draft)
  .sort((a, b) => {
    // featured first, then by date desc
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;
    return b.data.publishDate.getTime() - a.data.publishDate.getTime();
  });

const statusColors: Record<string, string> = {
  alpha: "badge-warning",
  beta: "badge-info",
  stable: "badge-success",
};
---

<section id="proyectos" class="w-full max-w-5xl mx-auto py-12 animate-fade-in">
  <h2 class="text-2xl font-bold mb-8 flex items-center gap-2">
    <span class="text-primary">#</span> Proyectos
  </h2>

  {
    visible.length === 0 ? (
      <p class="text-base-content/50 text-sm">
        No hay proyectos publicados por el momento.
      </p>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {visible.map((p) => (
          <article
            class={`card bg-base-100 border border-base-200 hover:shadow-md hover:-translate-y-1 transition-all duration-300 flex flex-col${p.data.featured ? " sm:col-span-2 lg:col-span-1" : ""}`}
          >
            <a
              href={`/projects/${p.id}`}
              class="block overflow-hidden rounded-t-box"
            >
              <figure class="h-44 bg-base-200 overflow-hidden">
                {p.data.image ? (
                  <Image
                    src={p.data.image}
                    alt={p.data.title}
                    class="object-cover w-full h-full transition-transform duration-500 hover:scale-105"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-base-content/20 text-xs tracking-widest uppercase">
                    sin imagen
                  </div>
                )}
              </figure>
            </a>

            <div class="card-body p-4 flex flex-col gap-2 flex-1">
              <div class="flex items-start justify-between gap-2">
                <a
                  href={`/projects/${p.id}`}
                  class="text-base font-semibold hover:text-primary transition-colors duration-200 leading-snug"
                >
                  {p.data.title}
                </a>
                {p.data.status && (
                  <span
                    class={`badge badge-outline text-xs shrink-0 uppercase tracking-wider ${statusColors[p.data.status] ?? ""}`}
                  >
                    {p.data.status}
                  </span>
                )}
              </div>

              <p class="text-sm text-base-content/70 leading-relaxed">
                {p.data.description}
              </p>

              <div class="flex flex-wrap gap-1 mt-auto pt-2">
                {(p.data.tags ?? []).map((t: string) => (
                  <span class="badge badge-outline text-xs">{t}</span>
                ))}
              </div>

              <div class="flex items-center gap-2 pt-2 border-t border-base-200 mt-1">
                <a
                  href={`/projects/${p.id}`}
                  class="text-xs text-base-content/50 hover:text-primary transition-colors duration-200"
                >
                  Ver detalle →
                </a>
                <div class="flex gap-2 ml-auto">
                  {p.data.github && (
                    <a
                      href={p.data.github}
                      class="btn btn-ghost btn-xs"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Repo
                    </a>
                  )}
                  {p.data.demo && (
                    <a
                      href={p.data.demo}
                      class="btn btn-primary btn-xs text-white"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Demo
                    </a>
                  )}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    )
  }
</section>
