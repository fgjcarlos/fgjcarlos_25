---
import skillsData from "../config/skills.json";

interface SkillsData {
  [category: string]: string[];
}

const skills = skillsData as SkillsData;
---

<section id="habilidades" class="py-12">
  <h2 class="text-3xl font-bold mb-8 flex items-center gap-2">
    <span class="text-primary">#</span> Habilidades & Stack
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {
      Object.entries(skills).map(([category, items]) => (
        <div class="card bg-base-100 shadow-sm border border-base-200 hover:border-primary/30 transition-all duration-300">
          <div class="card-body p-6">
            <h3 class="card-title text-xl font-semibold mb-4 text-primary">
              {category}
            </h3>
            <div class="flex flex-wrap gap-2">
              {items.map((skill) => (
                <span class="badge badge-outline badge-md py-3 px-4 hover:bg-primary hover:text-primary-content transition-all duration-300">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
