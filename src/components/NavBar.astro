---
import { Icon } from "astro-icon/components";

const navLinks = [
  { href: "/#sobre-mi", label: "Sobre mí" },
  { href: "/#proyectos", label: "Proyectos" },
  { href: "/#contacto", label: "Contacto" },
];
---

<nav class="cine-nav">
  <div class="cine-nav-brand">
    <a href="/" class="cine-pill cine-pill-brand">
      <span>FGJCARLOS</span>
      <span class="cine-cursor" aria-hidden="true"></span>
    </a>
  </div>

  <!-- Desktop -->
  <ul class="cine-pill cine-pill-links">
    {
      navLinks.map((link) => (
        <li>
          <a href={link.href} class="cine-nav-link">
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>

  <!-- Theme toggle -->
  <button
    type="button"
    data-theme-toggle
    class="cine-pill cine-pill-toggle btn btn-ghost btn-circle"
    aria-label="Modo oscuro"
    aria-pressed="false"
  >
    <Icon name="arcticons:moon" class="theme-icon-moon size-5" />
    <svg
      class="theme-icon-sun size-5"
      viewBox="0 0 48 48"
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="24" cy="24" r="10"></circle>
      <path
        d="M24 4v6M24 38v6M4 24h6M38 24h6M9.9 9.9l4.24 4.24M33.86 33.86l4.24 4.24M38.1 9.9l-4.24 4.24M14.14 33.86l-4.24 4.24"
      ></path>
    </svg>
  </button>

  <!-- Mobile hamburger -->
  <details data-mobile-nav-menu class="md:hidden dropdown dropdown-end">
    <summary
      role="button"
      class="cine-pill cine-pill-toggle btn btn-ghost list-none"
      aria-label="Abrir menú de navegación"
    >
      <Icon name="arcticons:hamburger-menu" class="size-5" />
    </summary>
    <ul
      class="cine-mobile-menu dropdown-content menu z-50 mt-2 w-48 rounded-box bg-base-200 border border-base-300 shadow-md"
    >
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="cine-menu-link hover:text-primary hover:translate-x-1 transition-all duration-200"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </details>
</nav>

<script>
  const applyStoredTheme = () => {
    let stored = null;
    try {
      stored = localStorage.getItem("theme");
    } catch {
      /* localStorage bloqueado: se queda en oscuro */
    }
    document.documentElement.dataset.theme =
      stored === "light" ? "light" : "dark";
  };

  /** `aria-pressed` dice si el modo oscuro está activo. */
  const syncThemeToggle = () => {
    const btn = document.querySelector("[data-theme-toggle]");
    if (!(btn instanceof HTMLElement)) return;

    btn.setAttribute(
      "aria-pressed",
      String(document.documentElement.dataset.theme === "dark"),
    );
  };

  const bindThemeToggle = () => {
    const btn = document.querySelector("[data-theme-toggle]");
    if (!(btn instanceof HTMLElement) || btn.dataset.bound) {
      return;
    }
    btn.dataset.bound = "true";
    btn.addEventListener("click", () => {
      const root = document.documentElement;
      const next = root.dataset.theme === "dark" ? "light" : "dark";
      root.classList.add("theme-transition");
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {
        /* memoria de sesión no disponible */
      }
      window.setTimeout(() => root.classList.remove("theme-transition"), 350);
      syncThemeToggle();
    });
  };

  bindThemeToggle();
  applyStoredTheme();
  syncThemeToggle();
  // Con ClientRouter el DOM se reemplaza en cada navegación: re-aplicar y
  // re-vincular en after-swap (antes de pintar) y en page-load (botón nuevo).
  document.addEventListener("astro:after-swap", () => {
    applyStoredTheme();
    syncThemeToggle();
  });
  document.addEventListener("astro:page-load", () => {
    applyStoredTheme();
    syncThemeToggle();
    bindThemeToggle();
  });
</script>

<script>
  // El menú móvil se cierra solo: con Escape (devolviendo el foco al botón),
  // al pulsar fuera y al seguir un enlace. Los oyentes viven en `document` y
  // se registran una sola vez, así que no se duplican tras un swap del
  // ClientRouter.
  const closeMobileNav = (returnFocus: boolean) => {
    const menu = document.querySelector("[data-mobile-nav-menu]");
    if (!(menu instanceof HTMLDetailsElement) || !menu.open) return;

    menu.open = false;

    if (returnFocus) {
      const summary = menu.querySelector("summary");
      if (summary instanceof HTMLElement) summary.focus();
    }
  };

  if (!document.documentElement.dataset.mobileNavBound) {
    document.documentElement.dataset.mobileNavBound = "true";

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      closeMobileNav(true);
    });

    document.addEventListener("pointerdown", (event) => {
      const menu = document.querySelector("[data-mobile-nav-menu]");
      if (!(menu instanceof HTMLDetailsElement) || !menu.open) return;

      const target = event.target;
      if (target instanceof Node && menu.contains(target)) return;

      closeMobileNav(false);
    });

    document.addEventListener("click", (event) => {
      const menu = document.querySelector("[data-mobile-nav-menu]");
      if (!(menu instanceof HTMLDetailsElement) || !menu.open) return;

      const target = event.target;
      if (!(target instanceof Element)) return;
      if (!menu.contains(target) || !target.closest("a")) return;

      closeMobileNav(false);
    });
  }
</script>

<style>
  /* Barra fija a sangre: ocupa todo el ancho del viewport y flota sobre el
     contenido (no lo empuja hacia abajo). */
  .cine-nav {
    position: fixed;
    top: 1rem;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 1.5rem;
    pointer-events: none;
  }

  .cine-nav > * {
    pointer-events: auto;
  }

  .cine-nav-brand {
    margin-right: auto;
  }

  .cine-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-base-300);
    border-radius: 9999px;
    background: color-mix(in oklch, var(--color-base-100) 70%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 8px 30px oklch(0% 0 0 / 0.12);
  }

  .cine-pill-brand {
    font-weight: 700;
    letter-spacing: 0.08em;
    font-size: 0.85rem;
    transition:
      transform 0.3s ease,
      border-color 0.3s ease;
  }

  .cine-pill-brand:hover {
    transform: translateY(-1px);
    border-color: var(--fx-ink-accent);
  }

  .cine-cursor {
    width: 0.5em;
    height: 1em;
    background: var(--fx-ink-accent);
    display: inline-block;
  }

  .cine-pill-links {
    display: none;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    font-size: 0.85rem;
  }

  /* El menú de escritorio aparece desde md; el CSS scoped de Astro va fuera de
     @layer utilities, así que aquí manda más que la utilidad `hidden`. */
  @media (min-width: 768px) {
    .cine-pill-links {
      display: flex;
    }
  }

  .cine-nav-link {
    color: var(--color-base-content);
    transition: color 0.25s ease;
  }

  .cine-nav-link:hover {
    color: var(--fx-ink-accent);
  }

  .cine-pill-toggle {
    padding: 0.5rem;
    width: 2.75rem;
    height: 2.75rem;
  }

  /* Filas del menú móvil: 44px de alto y 8px entre ellas. */
  .cine-mobile-menu {
    gap: 0.5rem;
  }

  .cine-menu-link {
    display: flex;
    align-items: center;
    min-height: 44px;
  }
</style>
