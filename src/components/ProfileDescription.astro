---
import PhotoProfile from "../assets/photo.webp";
import { Image } from "astro:assets";
import ProfileLinks from "./ProfileLinks.astro";
import type { ProfileConfig } from "../types/config";
import Profile from "@config/profile.json";

const profile = Profile as ProfileConfig;
---

<section
  id="sobre-mi"
  class="w-full flex flex-col md:flex-row-reverse gap-8 items-center justify-between mt-8 transition-all duration-700 animate-slide-up"
>
  <div
    class="transform transition-all duration-500 hover:scale-110 hover:shadow-lg group"
  >
    <Image
      src={PhotoProfile}
      alt={profile.photoAlt}
      class="mask mask-squircle size-32 sm:size-36 md:size-48 transition-all duration-300 group-hover:brightness-110"
    />
  </div>
  <div class="flex flex-col items-center md:items-start md:flex-1">
    <p class="text-sm uppercase tracking-[0.3em] text-base-content/50 mb-2">
      {profile.brand}
    </p>
    <h1 class="text-2xl md:text-4xl font-bold text-center md:text-left">
      {profile.name}
    </h1>
    <p
      class="text-sm md:text-base text-base-content/70 mt-2 text-center md:text-left"
    >
      {profile.title}
    </p>
    <h2
      class="text-lg font-semibold mt-6 mb-2 hover:text-primary transition-colors duration-300 cursor-default"
    >
      Sobre mí
    </h2>
    <p class="max-w-2xl flex-1 bloque-con-margin">
      {
        profile.bio.map((segment) =>
          segment.emphasis ? (
            <span class="italic font-semibold hover:text-primary transition-colors duration-200">
              {segment.text}
            </span>
          ) : (
            segment.text
          ),
        )
      }
    </p>
    <ProfileLinks />
  </div>
</section>
