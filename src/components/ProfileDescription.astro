---
import PhotoProfile from "../assets/photo.webp";
import { Image } from "astro:assets";
import ProfileLinks from "./ProfileLinks.astro";
import type { BioSegment, ProfileConfig } from "../types/config";
import Profile from "@config/profile.json";

const profile = Profile as ProfileConfig;

// A segment flagged with `paragraphBreakBefore` starts a new paragraph. Without
// the flag every segment stays in the same paragraph, so a biography without
// markers renders exactly as one single paragraph.
const bioParagraphs: BioSegment[][] = [];
for (const segment of profile.bio) {
  if (segment.paragraphBreakBefore && bioParagraphs.length > 0) {
    bioParagraphs.push([segment]);
  } else if (bioParagraphs.length > 0) {
    bioParagraphs[bioParagraphs.length - 1].push(segment);
  } else {
    bioParagraphs.push([segment]);
  }
}
---

<section
  id="sobre-mi"
  class="w-full flex flex-col md:flex-row-reverse gap-8 items-center justify-between mt-8 transition-all duration-700 animate-slide-up"
>
  <div class="group">
    <Image
      src={PhotoProfile}
      alt={profile.photoAlt}
      class="mask mask-squircle size-32 sm:size-36 md:size-48 transition-all duration-500 hover:scale-110 hover:brightness-110 hover:drop-shadow-xl"
    />
  </div>
  <div class="flex flex-col items-center md:items-start md:flex-1">
    <h1 class="text-2xl md:text-4xl font-bold text-center md:text-left">
      {profile.name}
    </h1>
    <p
      class="text-sm md:text-base text-base-content/70 mt-2 text-center md:text-left"
    >
      {profile.title}
    </p>
    <h2
      class="text-lg font-semibold mt-6 mb-2 hover:text-primary transition-colors duration-300 cursor-default"
    >
      Sobre mí
    </h2>
    <div class="bio-texto max-w-2xl flex-1">
      {
        bioParagraphs.map((paragraph) => (
          <p class="bloque-con-margin">
            {paragraph.map((segment) =>
              segment.emphasis ? (
                <span
                  class="italic font-semibold hover:text-primary transition-colors duration-200"
                  set:text={segment.text}
                />
              ) : (
                segment.text
              ),
            )}
          </p>
        ))
      }
    </div>
    <ProfileLinks />
  </div>
</section>
