---
import Layout from "@layouts/Layout.astro";
---

<Layout title="Página no encontrada - FGJCARLOS">
  <section
    class="flex flex-col items-center justify-center flex-1 gap-4 text-center px-6 pt-24"
  >
    <h1 class="font-display text-6xl font-bold tracking-tight">404</h1>
    <p class="text-lg">La página que buscas no existe.</p>
    <a
      href="/"
      class="underline underline-offset-4 transition-colors duration-200 hover:text-primary"
      >Volver al inicio</a
    >
  </section>
</Layout>
